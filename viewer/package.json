{
  "name": "ffix3dvr-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "publish-assets": "node scripts/publish-assets.mjs",
    "smoke": "node scripts/smoke-viewer.mjs",
    "deploy:pages": "npm run build && npx wrangler pages deploy dist --project-name ffix3dvr"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.2",
    "vite": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.181.0",
    "@types/webxr": "^0.5.23",
    "playwright-core": "^1.60.0",
    "typescript": "^5.9.3"
  }
}
